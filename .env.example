# --- Required ---
# from @BotFather
BOT_TOKEN=
# game4station api-token
G4S_API_TOKEN=
# your Telegram numeric ID(s), comma-separated
OWNER_IDS=
# python -m bot.keygen  (v1:...)
ENCRYPTION_KEYS=
# python -m bot.keygen
HMAC_KEY=

# --- Firestore (one of the two) ---
# service-account JSON, raw or base64
FIREBASE_CREDENTIALS_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Webhook (Render sets RENDER_EXTERNAL_URL automatically) ---
# python -m bot.keygen
WEBHOOK_SECRET=
# WEBHOOK_BASE_URL=https://your-service.onrender.com

# --- Optional ---
# G4S_PROXY_URL=http://user:pass@static-ip-proxy:port   # static IP for game4station allow-list
DEFAULT_MARGIN_PERCENT=10
CURRENCY_SYMBOL=$
LOW_PROVIDER_BALANCE=20
SUPPORT_CONTACT=@your_support
LOG_RETENTION_DAYS=180
ACTIONS_PER_MINUTE=30
ORDERS_PER_MINUTE=5
ORDER_POLL_SECONDS=60
BALANCE_CHECK_SECONDS=600
